{
  "name": "@culto/taskdroid-core",
  "description": "Schemas, workflow rules, storage, and domain service for Taskdroid projects.",
  "version": "0.1.2",
  "author": "Culto",
  "license": "GPL-3.0-or-later",
  "repository": { "type": "git", "url": "https://github.com/hyde-wyvern/taskdroid.git", "directory": "packages/core" },
  "homepage": "https://github.com/hyde-wyvern/taskdroid#readme",
  "bugs": { "url": "https://github.com/hyde-wyvern/taskdroid/issues" },
  "engines": { "node": ">=22" },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "prepack": "node ../../scripts/prepare-workspace-pack.mjs",
    "postpack": "node ../../scripts/cleanup-workspace-pack.mjs"
  },
  "dependencies": { "proper-lockfile": "^4.1.2", "zod": "^4.1.11" },
  "devDependencies": { "@types/proper-lockfile": "^4.1.4" },
  "publishConfig": { "access": "public" }
}
